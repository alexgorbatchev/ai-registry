# AI Registry Environment Configuration

DOCS_INTERNAL_DIR="docs/internal"

# Optional PATH-style list of private overlay registry directories (: on Linux/macOS, ; on Windows).
# The overlay directory can contain its own skills/ and commands/ directories
# merged left to right on build; the last matching name wins. Duplicate paths keep their last occurrence.
# AI_REGISTRY_OVERLAY=~/work/ai-registry:~/personal/ai-registry

# Optional PATH-style list of folders whose git checkouts Codex trusts, including declared submodules.
# AI_REGISTRY_CODEX_TRUSTED_DIRS=~/development

# Required by the Pi lg-llm provider (harnesses/pi/models.json); both are rendered at build time.
# A build that lacks them reads them from the login shell, so interactive shell startup files suffice.
LGLLM_API_URL="https://llm.example.com/v1"
LGLLM_API_KEY="sk-..."
