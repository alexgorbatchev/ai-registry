# Apply formatting
fmt:
    bun run oxfmt .

# Fail on unformatted files without rewriting them
fmt-check:
    bun run oxfmt --check .

# Lint
lint:
    bun run oxlint --deny-warnings .

# Apply lint fixes and formatting
fix:
    bun run oxlint --fix .
    bun run oxfmt .

# Type check
typecheck:
    bun run tsc -p tsconfig.json

# Report unused exports, properties, and types
unused:
    bun run --bun ts-unused check tsconfig.json

# Run the test suite
test:
    bash ../../../packages/registry-cli/src/bin/run-tests.sh bun test

# Run tests with coverage and enforce the 90% line and function gate
coverage:
    bash ../../../packages/registry-cli/src/bin/run-tests.sh bash -c 'bun test --coverage --coverage-reporter=lcov --coverage-dir="$TMPDIR/coverage" && bun ../../../packages/registry-cli/src/bin/check-coverage.ts "$TMPDIR/coverage/lcov.info" "*.ts"'

# Validate without modifying source files
check: fmt-check lint typecheck unused coverage
