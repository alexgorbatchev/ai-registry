{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "formatter": false,
  "default_agent": "developer",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "plugin": [
    "file://{{repo_root}}/vendor/opencode-context-inspector/src/index.ts"
  ],
  "instructions": [
    "{{repo_root}}/system/system.md"
  ],
  "mcp": {},
  "permission": {
    "question": "allow",
    "external_directory": {
      "{{repo_root}}/**": "allow",
      "~/**": "allow",
      "/home/alex/development/ai/ai-registry/**": "allow"
    },
    "bash": {
      "git checkout *": "ask",
      "git reset *": "ask"
    }
  },
  "disabled_providers": [],
  "experimental": {
    "mcp_timeout": 420000
  }
}
