{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "formatter": false,
  "default_agent": "developer",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "plugin": [
    "file://<%- repo_root %>/vendor/opencode-context-inspector/src/index.ts"
  ],
  "instructions": [
    "<%- repo_root %>/system/system.md"
  ],
  "mcp": {},
  "permission": {
    "question": "allow",
    "external_directory": {
      "<%- repo_root %>/**": "allow",
      "~/**": "allow"
    },
    "bash": {
      "git checkout -f*": "deny",
      "git checkout * -f*": "deny",
      "git checkout --force*": "deny",
      "git checkout * --force*": "deny",
      "git checkout -B*": "deny",
      "git checkout * -B*": "deny",
      "git checkout --ours*": "deny",
      "git checkout * --ours*": "deny",
      "git checkout --theirs*": "deny",
      "git checkout * --theirs*": "deny",
      "git checkout -- *": "deny",
      "git checkout * -- *": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "git reset --soft*": "deny",
      "git reset * --soft*": "deny",
      "git reset --mixed*": "deny",
      "git reset * --mixed*": "deny",
      "git reset --merge*": "deny",
      "git reset * --merge*": "deny",
      "git reset --keep*": "deny",
      "git reset * --keep*": "deny"
    }
  },
  "disabled_providers": [],
  "experimental": {
    "mcp_timeout": 420000
  }
}
