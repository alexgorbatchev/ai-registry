{
  "packages": [
    "npm:@aliou/pi-processes",
    "npm:pi-tool-display",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-file-change-reminder",
    "npm:pi-timestamps",
    "npm:pi-herdr-btw",
    "git:github.com/alexgorbatchev/pi-codegraph@fix/dangling-managed-symlinks",
    "npm:pi-provider-litellm",
    "npm:@alexgorbatchev/pi-skill-library",
    "npm:@alexgorbatchev/pi-env",
    "npm:@alexgorbatchev/pi-quick-answer",
    "npm:@alexgorbatchev/pi-workspace"
  ],
  "steeringMode": "one-at-a-time",
  "enabledModels": [
    "google/gemini-3.1-pro-preview",
    "google/gemini-3.7-flash",
    "google/gemini-3.8-flash",
    "litellm/*"
  ],
  "@alexgorbatchev/pi-env": {
    "AGENT": "1"
  },
  "@alexgorbatchev/pi-quick-answer": {
    "models": [
      "litellm/gemini-2.5-flash"
    ]
  },
  "litellm": {
    "providers": {
      "litellm": {
        "headers": {
          "User-Agent": "pi/1.0.4"
        }
      }
    },
    "skills": {
      "enabled": false
    },
    "mcp": {
      "enabled": false
    }
  },
  "enableSkillCommands": true,
  "lastChangelogVersion": "1.0.4",
  "hideThinkingBlock": false,
  "defaultProvider": "litellm",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "theme": "dark"
}
