{
  "name": "@alexgorbatchev/ai-registry",
  "version": "1.0.0",
  "description": "Canonical AI skills, commands, and harness profiles",
  "private": true,
  "workspaces": [
    "vendor/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run typecheck && air-build",
    "bootstrap": "air-bootstrap",
    "bootstrap:smoke": "air-smoke-bootstrap",
    "prepare": "bun run packages/registry-cli/src/bin/install-git-hooks.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sync:opencode-docs": "air-sync-opencode-docs",
    "skills:add": "air-add-vendored-skill",
    "skills:list": "npx skills add . --list",
    "skills:update": "air-update-vendored-skills && bun run build"
  },
  "dependencies": {
    "@alexgorbatchev/dedent-string": "^1.0.1",
    "@alexgorbatchev/template-resolver": "workspace:*",
    "@types/ignore-walk": "^4.0.3",
    "globby": "^16.2.0",
    "ignore-walk": "^8.0.0"
  },
  "devDependencies": {
    "@alexgorbatchev/registry-cli": "workspace:*",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/bun": "^1.3.13",
    "typescript": "rc"
  }
}
