# Run the CLI in human mode
[positional-arguments]
run *args:
    bun src/cli.ts "$@"

# Run the CLI in agent-facing mode
[positional-arguments]
run-ai *args:
    AGENT=1 bun src/cli.ts "$@"

# Apply formatting
fmt:
    bun run oxfmt src

# Fail on unformatted files without rewriting them
fmt-check:
    bun run oxfmt --check src

# Lint
lint:
    bun run oxlint --deny-warnings src

# Apply lint fixes and formatting
fix:
    bun run oxlint --fix src
    bun run oxfmt src

# Type check
typecheck:
    bun run tsc -p tsconfig.json

# Report unused exports, properties, and types
unused:
    bun run --bun ts-unused check tsconfig.json

# Confirm the CLI starts and renders help
smoke:
    bun src/cli.ts --help > /dev/null

# Run the test suite
test:
    bash ../registry-cli/src/bin/run-tests.sh bun test src

# Validate without modifying source files
check: fmt-check lint typecheck unused smoke test
