# Registry commands resolve the repository from the working directory, so they
# run from the repository root; tests and coverage run from this package.

# Build generated harness outputs; pass -y to confirm prompts
[positional-arguments]
[working-directory('../..')]
build *args:
    bun packages/registry-cli/src/bin/build.ts "$@"

# Install dependencies, build, and apply generated outputs to harness homes
[positional-arguments]
[working-directory('../..')]
bootstrap *args:
    bun packages/registry-cli/src/bin/bootstrap.ts "$@"

# Validate the bootstrap flow against .tmp/bootstrap-smoke/
[working-directory('../..')]
bootstrap-smoke:
    bun packages/registry-cli/src/bin/smoke-bootstrap.ts

# Pull, bootstrap, and push under the scheduled-update lock
[working-directory('../..')]
scheduled-update:
    bun packages/registry-cli/src/bin/scheduled-update.ts

# Point Git at the checked-in hooks
[working-directory('../..')]
install-git-hooks:
    bun packages/registry-cli/src/bin/install-git-hooks.ts

# Refresh the checked-in OpenCode docs snapshot
[working-directory('../..')]
sync-opencode-docs:
    bun packages/registry-cli/src/bin/sync-opencode-docs.ts

# Vendor an external skill: just skills-add 'npx skills add <source> --skill <name>'
[positional-arguments]
[working-directory('../..')]
skills-add *args:
    bun packages/registry-cli/src/bin/add-vendored-skill.ts "$@"

# Refresh vendored external skills
[working-directory('../..')]
skills-update:
    bun packages/registry-cli/src/bin/update-vendored-skills.ts

# Apply formatting
fmt:
    bun run oxfmt src

# Fail on unformatted files without rewriting them
fmt-check:
    bun run oxfmt --check src

# Lint
lint:
    bun run oxlint --deny-warnings src

# Apply lint fixes and formatting
fix:
    bun run oxlint --fix src
    bun run oxfmt src

# Type check
typecheck:
    bun run tsc -p tsconfig.json

# Report unused exports, properties, and types
unused:
    bun run --bun ts-unused check tsconfig.json

# Run the test suite
test:
    bun test

# Run tests with coverage and enforce the 90% line and function gate
coverage:
    bun test --coverage --coverage-reporter=lcov --coverage-dir=.tmp/coverage
    bun src/bin/check-coverage.ts .tmp/coverage/lcov.info

# Validate without modifying source files
check: fmt-check lint typecheck unused coverage
